{
  "marketplace": {
    "marketplace_create_proposal_draft": {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "readOnlyHint": false
      },
      "description": "Preview or create an approved proposal through the configured marketplace adapter.",
      "input_schema": {
        "properties": {
          "amount": {
            "exclusiveMinimum": 0,
            "maximum": 1000000,
            "title": "Amount",
            "type": "number"
          },
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "cover_letter": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Cover Letter",
            "type": "string"
          },
          "dry_run": {
            "default": true,
            "title": "Dry Run",
            "type": "boolean"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "cover_letter",
          "evidence_ids",
          "amount",
          "idempotency_key",
          "approved"
        ],
        "title": "marketplace_create_proposal_draftArguments",
        "type": "object"
      }
    },
